{
  "apps": [
    {
      "name": "gympass-api",
      "script": "npm",
      "args": "start",
      "instances": 2,
      "exec_mode": "cluster",
      "watch": false,
      "merge_logs": true,
      "cwd": "/app",
      "env_production": {
        "NODE_ENV": "production",
        "PORT": 3333,
        "HOST": "0.0.0.0",
        "DATABASE_URL": "${DATABASE_URL}",
        "JWT_SECRET": "${JWT_SECRET}",
        "CLOUDINARY_KEY": "${CLOUDINARY_KEY}",
        "CLOUDINARY_SECRET": "${CLOUDINARY_SECRET}",
        "CLOUDINARY_NAME": "${CLOUDINARY_NAME}",
        "API_URL": "${API_URL}",
        "FRONTEND_URL": "${FRONTEND_URL}"
      }
    }
  ]
}
